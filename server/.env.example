# ── StoryForge 云数据库服务 · 环境变量 ──
# 复制为 .env 后按需修改；docker compose 会读取它。

# 监听
SF_PORT=8787
SF_HOST=0.0.0.0

# 数据目录（SQLite + 版本快照）。**必须挂载为持久卷。**
SF_DATA_DIR=./data
# 可选：单独指定库文件与版本目录
# SF_DB_FILE=./data/storyforge-cloud.db
# SF_VERSIONS_DIR=./data/versions

# 体积上限：解压后 / 压缩后。两者都要卡，压缩后那道用于挡 gzip 炸弹。
SF_MAX_PUSH_BYTES=67108864
SF_MAX_COMPRESSED_BYTES=8388608

# 单份版本快照的上限（解压后）与每项目保留份数
SF_MAX_SNAPSHOT_BYTES=33554432
SF_MAX_SNAPSHOT_COMPRESSED_BYTES=8388608
SF_SNAPSHOT_KEEP=40

# 会话与历史
SF_SESSION_TTL_DAYS=30
SF_VERSION_KEEP=20

# 传输安全：生产必须保持 0，且前面挂 HTTPS 反代。
# 仅在 localhost 调试时设为 1，否则浏览器会丢弃 Secure Cookie。
SF_ALLOW_INSECURE=0
# 在 nginx / Caddy 反代后必须为 1（读取 X-Forwarded-Proto / X-Forwarded-For）
SF_TRUST_PROXY=1

# 登录限流（双层）
# ① 按「IP + 用户名」：窗口内 5 次 → 429，连续 10 次 → 锁 15 分钟（423）
SF_LOGIN_WINDOW_MINUTES=15
SF_LOGIN_MAX_ATTEMPTS=5
SF_LOGIN_LOCK_AFTER=10
SF_LOGIN_LOCK_MINUTES=15
# ② 按「IP 全局」：跨用户名的失败上限，挡住密码喷洒（拿一份密码把所有账号各试一次）。
#    没有这一层，攻击者换个用户名就能重置计数。
SF_LOGIN_IP_MAX_ATTEMPTS=30
# 限流表的最大条目数。键由请求内容决定，攻击者可用海量随机用户名把它撑爆，
# 所以必须有硬上限：超了就按最早时间淘汰。
SF_LOGIN_TRACK_MAX=5000

# CSRF：站点对外地址。**建议显式设置**，设了之后只认它，不再按 Host 头推导
# （否则伪造 Host 就能让 Origin 校验自己和自己对上）。
# 例：SF_PUBLIC_ORIGIN=https://sf.example.com
SF_PUBLIC_ORIGIN=
# CSRF：额外允许的来源（逗号分隔）。同源请求无需配置。
# 例：SF_ALLOWED_ORIGINS=https://sf.example.com
SF_ALLOWED_ORIGINS=

# 图形验证码（服务端生成 SVG，客户端用 <img> 显示，零依赖）
# 同一 IP 失败几次后开始要求验证码：
#   3  = 默认，前几次不打扰
#   0  = 每次登录都要（最严格，适合直接暴露在公网）
#   负数 = 完全关闭
SF_CAPTCHA_AFTER=3
# 单张有效期（秒）
SF_CAPTCHA_TTL_SECONDS=300
# 挑战表条目硬上限（防止"疯狂拉验证码"把内存打满）
SF_CAPTCHA_STORE_MAX=2000
# 单个 IP 在限流窗口内最多能拉多少张
SF_CAPTCHA_ISSUE_MAX=60
